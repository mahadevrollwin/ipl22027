# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=0q48dl6f
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-18

# Canonical site origin used by the dynamic sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.ipl2027.co

# Optional: required only if the dataset is private
SANITY_API_READ_TOKEN=

# Editor or Admin token — used by `npm run sanity:seed`
SANITY_API_WRITE_TOKEN=

# Shared secret for /api/revalidate (Sanity webhook → on-demand sitemap/cache refresh)
# Generate a long random string and set the same value in Vercel + Sanity webhook URL/header
REVALIDATE_SECRET=
